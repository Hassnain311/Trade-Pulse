# ─── TradePulse Frontend Environment Variables ───────────────────
# Copy this file to .env and fill in your values.
# NEVER commit the actual .env file to Git.

# Your Express backend URL
# In development this is localhost:3000 (default)
# In production replace with your deployed backend URL
VITE_API_URL=http://localhost:3000

# ─── NOTES ───────────────────────────────────────────────────────
# All sensitive secrets (JWT_SECRET, DB passwords, API keys)
# belong in the BACKEND .env — never put them here.
# Vite exposes every VITE_ variable to the browser bundle,
# so anything here is public to anyone who inspects your JS.
